	<array>
		<string>RethinkSans-VariableFont.ttf</string>
		<string>RethinkSans-Italic-VariableFont.ttf</string>
		<string>HedvigLettersSerif-VariableFont.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
